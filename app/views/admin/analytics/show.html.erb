<% content_for :title, "Analytics" %>
<div class="head">
  <h1>Last <%= @days %> days</h1>
  <span class="grow"></span>
  <div class="seg"><% { "7" => "7 days", "30" => "30 days", "90" => "90 days" }.each do |k, label| %><%= link_to label, admin_analytics_path(days: k, source: @source), class: ("on" if @days.to_s == k) %><% end %></div>
  <div class="seg"><% { "all" => "Everywhere", "widget" => "In our app", "kb" => "Help center", "api" => "API" }.each do |k, label| %><%= link_to label, admin_analytics_path(days: @days, source: k), class: ("on" if @source == k) %><% end %></div>
</div>

<section class="card chart-card">
  <div class="top">
    <div><div class="big"><%= number_with_delimiter @dead_ends %></div>
      <div class="lbl">searches found no answer<%= ", #{(100.0 * @dead_ends / @total).round(1)}% of #{number_with_delimiter @total}" if @total.positive? %></div></div>
    <div class="legend"><span><i style="background:var(--line-strong)"></i>All searches</span><span><i style="background:var(--ink)"></i>No answer</span></div>
  </div>
  <%= searches_chart(@series, @dead_series) %>
</section>

<div class="stats">
  <div class="card stat"><div class="lbl">Found an answer</div><div class="val"><%= @answered_pct ? "#{@answered_pct}%" : "–" %></div><div class="chg"><%= change_vs(@answered_pct, @prev_answered_pct, unit: " pts") %></div></div>
  <div class="card stat"><div class="lbl">Article views</div><div class="val"><%= number_with_delimiter @views %></div><div class="chg"><%= change_vs(@views, @prev_views, unit: "") %></div></div>
  <div class="card stat"><div class="lbl">Rated helpful</div><div class="val"><%= @helpful_pct ? "#{@helpful_pct}%" : "–" %></div><div class="chg t3">Of readers who voted</div></div>
  <div class="card stat"><div class="lbl">Searches</div><div class="val"><%= number_with_delimiter @total %></div><div class="chg t3"><%= @source == "all" ? "Everywhere" : "Filtered" %></div></div>
</div>

<div class="split">
  <section class="card">
    <div class="card-head"><h2>Searches with no answer</h2><span class="grow"></span><%= link_to "Export CSV", admin_analytics_path(days: @days, source: @source, format: :csv), style: "font-size:13px" %></div>
    <% if @no_answer.any? %>
      <% top = @no_answer.values.max %>
      <ol class="rank">
        <% @no_answer.each do |query, count| %>
          <li><span class="q"><%= query %><% if (page = @no_answer_pages[query]) %><span class="meta"><%= page %></span><% end %></span><span class="v"><%= count %></span>
            <span class="bar"><span style="width:<%= (100.0 * count / top).round %>%"></span></span></li>
        <% end %>
      </ol>
    <% else %><p class="meta" style="padding:0 20px 20px">None in this period.</p><% end %>
  </section>
  <section class="card">
    <div class="card-head"><h2>Top articles</h2></div>
    <div class="table-wrap"><table class="data">
      <thead><tr><th>Article</th><th class="num">Views</th><th class="num">Helpful</th></tr></thead>
      <tbody>
        <% @top_counts.each do |id, count| %>
          <% a = @top_articles[id] or next %>
          <% votes = a.upvotes + a.downvotes; helpful = votes.positive? ? (100.0 * a.upvotes / votes).round : nil %>
          <tr><td><div class="title-cell" style="min-width:0"><%= code_tag a.code %><%= link_to a.versions.max_by(&:number)&.title, edit_admin_article_path(a), style: "font-weight:400" %></div></td>
            <td class="num"><%= number_with_delimiter count %></td>
            <td class="num" style="<%= "color:var(--neg)" if helpful && helpful < 70 %>"><%= helpful ? "#{helpful}%" : "–" %></td></tr>
        <% end %>
        <% if @top_counts.empty? %><tr><td colspan="3" class="meta">No views in this period.</td></tr><% end %>
      </tbody>
    </table></div>
  </section>
</div>

<div class="split" style="margin-top:16px">
  <section class="card">
    <div class="card-head"><h2>Where people use help in our app</h2></div>
    <div class="table-wrap"><table class="data">
      <thead><tr><th>Page in our app</th><th class="num">Searches + views</th><th class="num">No answer</th></tr></thead>
      <tbody>
        <% @pages.each do |page, count| %>
          <tr><td class="mono"><%= page %></td><td class="num"><%= count %></td><td class="num" style="<%= "color:var(--neg)" if @page_dead_ends[page].to_i > count / 5 %>"><%= @page_dead_ends[page].to_i %></td></tr>
        <% end %>
        <% if @pages.empty? %><tr><td colspan="3" class="meta">No widget activity yet.</td></tr><% end %>
      </tbody>
    </table></div>
  </section>
  <section class="card">
    <div class="card-head"><h2>Recent "not helpful" feedback</h2></div>
    <div style="padding:0 20px 16px">
      <% @not_helpful.each do |v| %>
        <div class="comment"><%= code_tag v.article.code, style: "color:var(--ink)" %> <b style="font-weight:500"><%= v.article.versions.max_by(&:number)&.title %></b>
          <p class="meta" style="margin:4px 0 0">"<%= v.comment %>" · <%= v.source == "widget" ? "in our app" : "help center" %> · <%= relative_day(v.created_at).downcase %></p></div>
      <% end %>
      <% if @not_helpful.empty? %><p class="meta">None yet.</p><% end %>
    </div>
  </section>
</div>
