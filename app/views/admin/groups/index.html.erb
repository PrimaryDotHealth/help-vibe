<% content_for :title, "Groups" %>
<div class="head">
  <h1>Groups</h1><span class="count"><%= @groups.size %></span>
  <span class="grow"></span>
  <%= link_to "People", admin_users_path, class: "btn quiet" %>
  <%= link_to new_admin_group_path, class: "btn primary" do %><%= icon "plus" %>New group<% end %>
</div>
<div class="card">
  <% if @groups.any? %>
    <div class="table-wrap"><table class="data">
      <thead><tr><th>Group</th><th>Members</th><th>Auto-join</th><th></th></tr></thead>
      <tbody><% @groups.each do |g| %>
        <tr><td><b style="font-weight:500"><%= g.name %></b></td><td class="meta"><%= g.users.map(&:name).join(", ").presence || "–" %></td>
          <td class="mono t3"><%= g.domain_list.presence || "–" %></td><td style="text-align:right"><%= link_to "Edit", edit_admin_group_path(g) %></td></tr>
      <% end %></tbody>
    </table></div>
  <% else %>
    <div class="blank"><h2>No groups yet</h2><p>Groups let you share private articles with a team, like "Support" or "Billing".</p></div>
  <% end %>
</div>
