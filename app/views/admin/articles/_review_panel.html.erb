<%# Inputs here belong to forms rendered after the editor form (no nested forms). %>
<% review = version.open_review %>
<section id="review">
  <h3>Review</h3>
  <% if review %>
    <p class="meta" style="margin-bottom:8px">
      Requested by <%= review.requested_by&.name || "someone" %> · <%= review.rule == "all" ? "all reviewers must approve" : "any reviewer can approve" %>
    </p>
    <% review.assignments.each do |a| %>
      <div class="review-line"><span class="avatar"><%= (a.user&.initials || a.group.name[0, 2]).upcase %></span><span class="grow"><%= a.label %></span>
        <span class="status <%= { "approved" => "live", "pending" => "review", "changes_requested" => "changes" }[a.decision] %>"><%= a.decision.humanize %></span></div>
      <% if a.message.present? %><p class="meta" style="margin:0 0 8px 32px">"<%= a.message %>"<%= " · #{a.decided_by.name}" if a.decided_by %></p><% end %>
    <% end %>
    <% if review.note.present? %><p class="meta" style="margin-top:8px">"<%= review.note %>"</p><% end %>
    <% if review.status == "pending" && review.assignments_for(Current.user).any? { _1.decision == "pending" } %>
      <textarea name="message" form="decide-form" class="input" rows="2" placeholder="Message (needed for changes)" style="margin-top:12px"></textarea>
      <div class="row" style="margin-top:8px">
        <button type="submit" form="decide-form" name="decision" value="approved" class="btn sm primary">Approve</button>
        <button type="submit" form="decide-form" name="decision" value="changes_requested" class="btn sm">Request changes</button>
      </div>
    <% end %>
    <% unless review.status == "approved" %>
      <button type="submit" form="withdraw-form" class="btn sm quiet" style="margin-top:8px">Withdraw request</button>
    <% end %>
  <% else %>
    <select name="reviewer_keys[]" form="review-form" multiple class="input" style="height:auto;min-height:72px;padding:4px" aria-label="Reviewers">
      <%= grouped_options_for_select({ "Groups" => Group.order(:name).map { [ _1.name, "group:#{_1.id}" ] },
                                       "People" => User.active.where.not(id: Current.user.id).where(role: %w[superadmin admin collaborator]).order(:first_name).map { [ _1.name, "user:#{_1.id}" ] } }) %>
    </select>
    <input name="note" form="review-form" class="input" placeholder="What should they check? (optional)" style="margin-top:8px">
    <button type="submit" form="review-form" class="btn sm" style="margin-top:8px">Request review</button>
  <% end %>
</section>

<section id="comments" data-controller="quote">
  <h3>Comments <span class="code"><%= version.comments.unresolved.threads.count %></span></h3>
  <% version.comments.threads.includes(:author, replies: :author).each do |c| %>
    <div class="comment" style="<%= "opacity:.5" if c.resolved_at %>">
      <div class="row small"><span class="avatar"><%= c.author&.initials %></span><b style="font-weight:500"><%= c.author&.name %></b><span class="meta"><%= relative_day(c.created_at).downcase %></span></div>
      <% if c.quote %><p class="meta" style="margin:6px 0;border-left:3px solid #f59e0b;padding-left:8px">"<%= c.quote %>"</p><% end %>
      <p style="margin:6px 0"><%= c.body %></p>
      <% c.replies.each do |r| %><p class="meta" style="margin:4px 0 4px 12px"><b><%= r.author&.first_name %>:</b> <%= r.body %></p><% end %>
      <button type="submit" form="comment-resolve-form" formaction="<%= admin_comment_path(c, resolved: c.resolved_at ? 0 : 1) %>" class="link" style="font-size:13px"><%= c.resolved_at ? "Reopen" : "Resolve" %></button>
    </div>
  <% end %>
  <input type="hidden" name="quote" form="comment-form" data-quote-target="field">
  <p class="meta" data-quote-target="preview" hidden></p>
  <textarea name="body" form="comment-form" class="input" rows="2" placeholder="Comment. Select text in the article first to quote it"></textarea>
  <button type="submit" form="comment-form" class="btn sm" style="margin-top:8px">Comment</button>
</section>

<section>
  <h3>Paste Markdown</h3>
  <textarea name="markdown" form="markdown-form" class="input mono" rows="3" placeholder="# Heading&#10;1. A step"></textarea>
  <div class="hint">Replaces the draft's text with this, converted. History keeps the previous text.</div>
  <button type="submit" form="markdown-form" class="btn sm" style="margin-top:8px" data-turbo-confirm="Replace the draft's text with this Markdown?">Convert into the draft</button>
</section>
