<%# The real forms for the review and comments panel (outside the editor form). %>
<%= form_with url: admin_version_reviews_path(version), id: "review-form" do %><% end %>
<% if (review = version.open_review) %>
  <%= form_with url: decide_admin_review_path(review), id: "decide-form" do %><% end %>
  <%= form_with url: admin_review_path(review), method: :delete, id: "withdraw-form" do %><% end %>
<% end %>
<%= form_with url: admin_version_comments_path(version), id: "comment-form" do %><% end %>
<%= form_with url: "#", method: :patch, id: "comment-resolve-form" do %><% end %>
