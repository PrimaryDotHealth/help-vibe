<%= render layout: "frame" do %>
  <% featured = @suggested.presence || @popular.to_a %>
  <% label = @suggested.present? ? "For this page" : "Most read" %>
  <div class="w-label"><%= label %><% if @page.present? %><span class="mono t3"><%= @page %></span><% end %></div>
  <% if (top = featured.first) && (v = top.live_version) %>
    <div class="answer">
      <h3><%= v.title %></h3>
      <% steps = v.current_revision&.body&.body&.to_html.to_s.then { Nokogiri::HTML5.fragment(_1).css("ol > li").first(3).map { |li| li.text.squish } } %>
      <% if steps.present? %>
        <ol><% steps.each do |step| %><li><%= step %></li><% end %></ol>
      <% elsif v.subtitle.present? %>
        <p class="t2" style="font-size:14px;margin-top:8px"><%= v.subtitle %></p>
      <% end %>
      <%= link_to "Read the full article", widget_article_path(top, page: @page), class: "more" %>
    </div>
    <% rest = featured.drop(1) %>
    <% if rest.any? %>
      <% if @suggested.present? %><div class="w-label" style="margin-top:16px">Also on this page</div><% end %>
      <ul class="w-list" style="margin-top:<%= @suggested.present? ? 0 : 12 %>px">
        <% rest.each do |a| %>
          <li><%= link_to widget_article_path(a, page: @page) do %><span><%= a.live_version.title %></span><%= icon "right" %><% end %></li>
        <% end %>
      </ul>
    <% end %>
    <% if @suggested.present? && @popular.any? %>
      <div class="w-label" style="margin-top:16px">Most read</div>
      <ul class="w-list">
        <% @popular.first(3).each do |a| %>
          <li><%= link_to widget_article_path(a, page: @page) do %><span><%= a.live_version.title %></span><%= icon "right" %><% end %></li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <p class="t2" style="font-size:14px;padding-top:24px">No help articles are published yet.</p>
  <% end %>
<% end %>
