<% body, _toc = article_body_with_toc(@version.current_revision) %>
<%= render layout: "frame", locals: { back: widget_root_path(page: params[:page]), code: @article.code, hide_search: true, full_url: article_url(@article) } do %>
  <div class="doc" style="padding-top:16px">
    <h3 style="font:400 22px/28px var(--serif)"><%= @version.title %></h3>
    <p class="meta" style="margin-top:4px"><%= @article.main_category.name %> · Updated <%= relative_day(@version.published_at || @version.updated_at).downcase %></p>
    <div class="rich" style="margin-top:16px;font-size:14px"><%= body %></div>
    <%= render "reader/articles/helpful", article: @article, vote: nil, source: "widget" %>
  </div>
<% end %>
