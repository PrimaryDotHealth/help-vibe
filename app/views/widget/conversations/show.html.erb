<%= turbo_stream_from @thread, :contact %>
<%= render layout: "widget/panel/frame", locals: { back: widget_conversations_path(page: params[:page]), hide_search: true, code: "##{@thread.number}" } do %>
  <div class="conversation" style="padding-top:12px">
    <div id="thread_parts"><%= render partial: "widget/conversations/part", collection: @parts %></div>
    <%= form_with url: reply_widget_conversation_path(@thread), class: "reply-box", data: { controller: "reset-form", action: "turbo:submit-end->reset-form#reset" } do %>
      <%= hidden_field_tag :client_id, SecureRandom.uuid %>
      <%= text_area_tag :body, nil, class: "input", rows: 3, required: true, placeholder: (@thread.state == "closed" ? "Reply to reopen" : "Reply"), maxlength: 20000 %>
      <div class="acts" style="margin-top:8px"><%= submit_tag "Send", class: "btn primary sm" %></div>
    <% end %>
  </div>
<% end %>
