<%= render layout: "widget/panel/frame", locals: { back: widget_root_path(page: params[:page]), hide_search: true } do %>
  <div style="padding-top:12px" data-controller="suggest" data-suggest-url-value="<%= widget_search_path %>">
    <h3 style="font:400 20px/26px var(--serif)">Ask a question</h3>
    <p class="meta" style="margin-top:4px">We usually reply within one business day.</p>
    <% if flash[:alert] %><p class="errors" style="margin-top:8px"><%= flash[:alert] %></p><% end %>
    <%= form_with url: widget_conversations_path, style: "margin-top:12px" do %>
      <%= hidden_field_tag :page, params[:page] %>
      <%= hidden_field_tag :client_id, SecureRandom.uuid %>
      <% unless current_contact %>
        <label class="field"><span>Your email</span><%= email_field_tag :email, params[:email], class: "input", required: true, autocomplete: "email" %></label>
        <label class="field"><span>Your name</span><%= text_field_tag :name, params[:name], class: "input", autocomplete: "name" %></label>
      <% end %>
      <label class="field"><span>Your question</span>
        <%= text_area_tag :body, params[:body], class: "input", rows: 5, required: true, maxlength: 20000, data: { action: "input->suggest#changed", suggest_target: "input" } %></label>
      <%= hidden_field_tag :q, nil, data: { suggest_target: "query" } %>
      <turbo-frame id="suggestions" data-suggest-target="frame"></turbo-frame>
      <div class="acts" style="margin-top:12px"><%= submit_tag "Send", class: "btn primary" %></div>
    <% end %>
  </div>
<% end %>
