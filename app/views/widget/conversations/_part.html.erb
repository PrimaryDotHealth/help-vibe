<%# One message as the contact sees it (also broadcast live). %>
<% if part.message? %>
  <div class="msg <%= part.from_contact? ? "me" : "them" %>" id="<%= dom_id(part) %>">
    <div class="meta"><%= part.from_contact? ? "You" : part.author_user&.first_name.presence || "Our team" %> · <%= part.created_at.strftime("%-d %b %H:%M") %></div>
    <div class="bubble"><%= render_message(part, for_contact: true, widget: true) %>
      <% part.files.each do |f| %><div><%= link_to f.filename, rails_blob_path(f, disposition: "attachment") %></div><% end %></div>
  </div>
<% else %>
  <div class="msg-event meta" id="<%= dom_id(part) %>"><%= part.kind == "close" ? "Marked as solved. Reply to reopen." : (part.kind == "open" ? "Reopened" : part.kind.humanize) %></div>
<% end %>
