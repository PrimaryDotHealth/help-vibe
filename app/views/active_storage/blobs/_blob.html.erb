<%# Images are served as uploaded (no libvips variants needed). SVG is never shown inline. %>
<figure class="attachment attachment--<%= blob.image? && blob.content_type != "image/svg+xml" ? "preview" : "file" %> attachment--<%= blob.filename.extension %>">
  <% if blob.image? && blob.content_type != "image/svg+xml" %>
    <%= image_tag rails_blob_path(blob, only_path: true), alt: blob.try(:caption).presence || "", loading: "lazy" %>
  <% else %>
    <%= link_to rails_blob_path(blob, disposition: "attachment", only_path: true) do %><%= blob.filename %><% end %>
  <% end %>
  <% if (caption = blob.try(:caption)).present? %><figcaption class="attachment__caption"><%= caption %></figcaption><% end %>
</figure>
