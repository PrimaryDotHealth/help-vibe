<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "helpvibe" %> · helpvibe</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body>
    <%= render "shared/icons" %>
    <% if content_for?(:full_page) %>
      <div class="toasts" aria-live="polite">
        <% flash.each do |type, message| %>
          <div class="toast <%= type %>" data-controller="toast" data-toast-sticky-value="<%= type.to_s == "alert" %>" role="<%= type.to_s == "alert" ? "alert" : "status" %>">
            <%= icon(type.to_s == "alert" ? "alert" : "check") %><span class="grow"><%= message %></span>
            <button type="button" class="x" data-action="toast#dismiss" aria-label="Dismiss"><%= icon "x" %></button>
          </div>
        <% end %>
      </div>
      <%= yield %>
    <% else %>
      <div class="app" style="min-height:100vh">
        <nav class="side" aria-label="Main">
          <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Show menu">
          <div class="side-top">
            <%= link_to admin_root_path, class: "wordmark" do %><span class="mark">h</span>helpvibe<% end %>
            <label for="nav-toggle" class="btn menu-btn"><%= icon "list" %>Menu</label>
          </div>
          <div class="side-body">
          <% nav = ->(label, ico, path, on) { link_to(safe_join([ icon(ico), label ]), path, class: [ "nav", ("on" if on) ]) } %>
          <% desk = helpdesk_area? %>
          <% if Current.user.agent? && Current.user.editor? %>
            <div class="seg product-switch">
              <%= link_to "Helpdesk", admin_inbox_path, class: ("on" if desk) %>
              <%= link_to "Articles", admin_articles_path, class: ("on" unless desk) %>
            </div>
          <% end %>
          <% if desk %>
            <% unread = Current.user.notifications.unread.count %>
            <%= link_to admin_inbox_path, class: [ "nav", ("on" if %w[inbox support_threads].include?(controller_name) && !@thread&.ticket?) ] do %><%= icon "inbox" %>Inbox<% if unread.positive? %><span class="count"><%= unread %></span><% end %><% end %>
            <%= nav.("Tickets", "file", admin_tickets_path, controller_name == "tickets" || (controller_name == "support_threads" && @thread&.ticket?)) %>
            <%= nav.("Saved replies", "message", admin_macros_path, controller_name == "macros") %>
            <% if Current.user.admin? %>
              <div class="label">Helpdesk settings</div>
              <%= nav.("Ticket types", "sliders", admin_ticket_types_path, %w[ticket_types ticket_states].include?(controller_name)) %>
              <%= nav.("Teams", "users", admin_teams_path, controller_name == "teams") %>
            <% end %>
            <% if Current.user.superadmin? || Current.user.permissions.include?("compliance") %>
              <%= nav.("Access log", "eye", admin_audit_events_path, controller_name == "audit_events") %>
            <% end %>
          <% else %>
            <%= nav.("Articles", "file", admin_articles_path, controller_name == "articles") %>
            <%= nav.("Chapters", "folder", admin_chapters_path, controller_name == "chapters") %>
            <%= nav.("Analytics", "chart", admin_analytics_path, controller_name == "analytics") %>
            <%= nav.("Page suggestions", "sign", admin_context_rules_path, controller_name == "context_rules") %>
            <% if Current.user.admin? %>
              <div class="label">Articles settings</div>
              <%= nav.("API and webhooks", "key", admin_api_keys_path, %w[api_keys webhooks].include?(controller_name)) %>
              <%= nav.("Activity", "history", admin_activities_path, controller_name == "activities") %>
              <%= nav.("Import", "db", admin_import_path, controller_name == "import") %>
            <% end %>
            <div class="label">Readers</div>
            <%= nav.("Help center", "globe", root_path, false) %>
            <%= nav.("Widget preview", "help", (Rails.env.local? ? dev_host_path : widget_root_path), false) %>
          <% end %>
          <% if Current.user.admin? %>
            <div class="label">Everyone</div>
            <%= nav.("People", "users", admin_users_path, %w[users groups].include?(controller_name)) %>
          <% end %>
          <div class="me"><span class="avatar"><%= Current.user.initials %></span><%= Current.user.name %>
            <span class="grow"></span><%= button_to "Sign out", session_path, method: :delete, class: "link", form_class: "inline", style: "font-size:13px" %></div>
          </div>
        </nav>
        <main class="main">
          <% flash.each do |type, message| %><div class="flash <%= type %>"><%= message %></div><% end %>
          <%= yield %>
        </main>
      </div>
    <% end %>
  </body>
</html>
