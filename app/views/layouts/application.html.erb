<!DOCTYPE html>
<html lang="en" <%= tag.attributes(data: { theme: page_theme }) %>>
  <head>
    <title><%= content_for(:title) || "Help Center" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="reader">
    <%= render "shared/icons" %>
    <header class="site-head">
      <div class="in">
        <%= link_to root_path, class: "wordmark" do %><span class="mark">h</span>Help Center<% end %>
        <% unless content_for?(:hide_header_search) %>
          <%= form_with url: search_path, method: :get, class: "search head-search", data: { turbo_frame: "_top" } do %>
            <%= icon "search" %>
            <%= search_field_tag :q, params[:q], class: "input", placeholder: "Search articles", "aria-label": "Search" %>
          <% end %>
        <% end %>
        <span class="grow"></span>
        <nav class="links">
          <%= link_to "Contact support", contact_path if help_center_contact? && controller_name != "contact" %>
          <% if authenticated? && Current.user&.editor? %>
            <%= link_to "Admin", admin_root_path %>
          <% elsif !authenticated? && !in_frame? %>
            <%= link_to "Staff sign in", new_session_path %>
          <% end %>
        </nav>
      </div>
    </header>
    <% flash.each do |type, message| %><div class="flash <%= type %>"><%= message %></div><% end %>
    <%= yield %>
    <footer class="site-foot">Help Center</footer>
  </body>
</html>
