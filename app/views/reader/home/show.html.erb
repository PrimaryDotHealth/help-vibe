<% content_for :title, "Help Center" %>
<% content_for :hide_header_search, true %>
<main class="wrap">
  <section class="home-head">
    <div>
      <h1>Guides for every part of the app</h1>
      <p>Step-by-step answers, kept current by our team.</p>
    </div>
    <div>
      <%= form_with url: search_path, method: :get, class: "search lg" do %>
        <%= icon "search" %>
        <%= search_field_tag :q, nil, class: "input", placeholder: "Search for an answer, e.g. reset password", "aria-label": "Search", autofocus: true %>
      <% end %>
      <% if @popular.any? %>
        <p class="popular">Most read: <% @popular.each do |a| %><%= link_to a.live_version.title, article_path(a) %><% end %></p>
      <% end %>
    </div>
  </section>

  <% if @chapters.empty? %>
    <div class="empty"><h2>Nothing here yet</h2><p>Articles appear here once they're published.</p></div>
  <% else %>
    <div class="contents">
      <% @chapters.each do |chapter| %>
        <% articles = @by_chapter.fetch(chapter.id, []) %>
        <section class="chapter">
          <div class="chapter-head"><h2><%= link_to chapter.name, chapter_path(chapter), style: "color:inherit" %></h2><span class="meta count"><%= pluralize(articles.size, "article") %></span></div>
          <% if chapter.description.present? %><p><%= chapter.description %></p><% end %>
          <ul>
            <% articles.sort_by { [ -_1.views, _1.code ] }.first(3).each do |a| %>
              <li><%= link_to a.live_version.title, article_path(a) %></li>
            <% end %>
          </ul>
          <% if articles.size > 3 %><%= link_to "All #{articles.size} in #{chapter.name}", chapter_path(chapter), class: "all" %><% end %>
        </section>
      <% end %>
    </div>
  <% end %>

  <section class="band">
    <div><h2>Can't find it?</h2><p>Our support team replies within one business day. Mention the article code if you have one.</p></div>
  </section>
</main>
