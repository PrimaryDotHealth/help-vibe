<%= turbo_frame_tag dom_id(article, :helpful) do %>
  <div class="helpful">
    <% if vote.nil? %>
      <b>Did this answer your question?</b>
      <%= button_to article_vote_path(article, value: 1, source: source), class: "btn sm", form_class: "inline" do %><%= icon "up" %>Yes<% end %>
      <%= button_to article_vote_path(article, value: -1, source: source), class: "btn sm", form_class: "inline" do %><%= icon "downvote" %>No<% end %>
    <% elsif vote.value == 1 %>
      <b>Thanks for letting us know.</b>
    <% elsif vote.comment.present? %>
      <b>Thanks for letting us know.</b>
      <% if source == "kb" && help_center_contact? %><span class="meta">Still stuck? <%= link_to "Contact support", contact_path(from: article_path(article)), data: { turbo_frame: "_top" } %></span><% end %>
    <% else %>
      <%= form_with url: article_vote_path(article, value: -1, source: source), class: "row grow", html: { style: "flex-wrap:wrap" } do %>
        <label class="grow"><span class="meta">What were you looking for?</span>
          <%= text_field_tag :comment, nil, class: "input", maxlength: 1000, placeholder: "Optional" %></label>
        <%= submit_tag "Send", class: "btn sm" %>
      <% end %>
      <% if source == "kb" && help_center_contact? %><p class="meta" style="width:100%;margin-top:8px">Need a person? <%= link_to "Contact support", contact_path(from: article_path(article)), data: { turbo_frame: "_top" } %></p><% end %>
    <% end %>
  </div>
<% end %>
