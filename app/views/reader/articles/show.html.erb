<% content_for :title, @version.title %>
<% body, toc = article_body_with_toc(@version.current_revision) %>
<div class="article">
  <nav class="chapter-nav" aria-label="<%= @chapter.name %>">
    <div class="head"><%= code_tag @chapter.code %><%= @chapter.name %></div>
    <% @siblings.each do |a| %>
      <%= link_to article_path(a), class: ("on" if a == @article) do %><%= code_tag a.code %><%= a.live_version&.title %><% end %>
    <% end %>
  </nav>

  <article class="doc">
    <% if @preview %><div class="flash" style="margin:0 0 16px">Preview of an unpublished version. Readers can't see this yet.</div><% end %>
    <div class="crumbs"><%= link_to "Help Center", root_path %> / <%= link_to @chapter.name, chapter_path(@chapter) %></div>
    <h1><%= @version.title %></h1>
    <% if @version.subtitle.present? %><p class="lede"><%= @version.subtitle %></p><% end %>
    <div class="docmeta">
      <%= code_tag @article.code %>
      <span class="meta">Updated <%= (@version.published_at || @version.updated_at).strftime("%-d %b %Y") %></span>
      <% if viewer && @article.accessibility != "public" %><%= visibility_tag @article.accessibility %><% end %>
    </div>
    <div class="rich numbered"><%= body %></div>

    <div class="helpful">
      <b>Did this answer your question?</b>
      <span class="quote-code">Asking support? Quote <%= code_tag @article.code %></span>
    </div>
  </article>

  <aside class="toc" aria-label="On this page">
    <% if toc.size > 1 %>
      <div class="head">On this page</div>
      <% toc.each_with_index do |(id, text), i| %><a href="#<%= id %>"><span class="code"><%= i + 1 %></span><%= text %></a><% end %>
    <% end %>
  </aside>
</div>
